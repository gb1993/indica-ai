{
  "name": "indica-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "email:dev": "email dev --dir src/emails",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --no-warnings --experimental-strip-types --test src/lib/content.test.ts src/lib/tmdb.test.ts src/lib/avatar.test.ts src/lib/validation.test.ts src/emails/group-invitation-content.test.ts",
    "test:coverage": "node --no-warnings --experimental-strip-types --test --experimental-test-coverage --test-coverage-include=src/lib/content.ts --test-coverage-include=src/lib/tmdb.ts --test-coverage-include=src/lib/avatar.ts --test-coverage-include=src/lib/validation.ts --test-coverage-include=src/emails/group-invitation-content.ts --test-coverage-lines=70 --test-coverage-functions=70 --test-coverage-branches=70 src/lib/content.test.ts src/lib/tmdb.test.ts src/lib/avatar.test.ts src/lib/validation.test.ts src/emails/group-invitation-content.test.ts",
    "test:db": "supabase test db",
    "test": "npm run test:coverage",
    "test:all": "npm run test:coverage && npm run test:db"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.1",
    "resend": "^6.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "supabase": "^2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
